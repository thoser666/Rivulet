#!/usr/bin/env bash
# Pre-push hook: mirror the CI "Lints (Fmt & Clippy)" job locally so a push
# can never break the required checks.
#
# Why `-D warnings`: CI runs `cargo clippy --workspace --all-targets -- -D
# warnings`, but a plain local `cargo clippy` only *warns* on lints such as
# `clippy::field_reassign_with_default` — commit 06792c6 shipped four GUI
# tests that were clean locally yet failed the CI Lints job. This hook uses
# the exact CI flags so the failure happens before the push, not after.
#
# Install (one time per clone):
#   git config core.hooksPath .githooks
#
# Skip for an individual push:
#   RIVULET_SKIP_PRE_PUSH=1 git push        # or: git push --no-verify
#
# The fast-guard stage (optional, default on) runs the CI pinning tests and
# the Lints-job script self-tests so the repo-internal guards pass before
# the push; disable just that stage with:
#   RIVULET_PRE_PUSH_FAST_TESTS=0 git push
set -euo pipefail

if [[ "${RIVULET_SKIP_PRE_PUSH:-}" == "1" || "${RIVULET_SKIP_PRE_PUSH:-}" == "true" ]]; then
  echo "pre-push: checks skipped (RIVULET_SKIP_PRE_PUSH=1)"
  exit 0
fi

# Resolve the repository root regardless of the hook's working directory.
repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

echo "pre-push: cargo fmt --all --check"
cargo fmt --all --check

echo "pre-push: cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

# ── Optional fast-guard stage ────────────────────────────────────────────
# Mirrors the CI Pinning-Tests job and the Lints-job script self-tests.
if [[ "${RIVULET_PRE_PUSH_FAST_TESTS:-}" != "0" ]]; then
  echo "pre-push: cargo test -p rivulet-core --test ci_pinning"
  cargo test -p rivulet-core --test ci_pinning

  if command -v python >/dev/null 2>&1; then
    echo "pre-push: python scripts/generate-action-pins.py --check"
    python scripts/generate-action-pins.py --check

    if git rev-parse --verify --quiet origin/develop >/dev/null; then
      echo "pre-push: python scripts/check-dco.py --base origin/develop"
      python scripts/check-dco.py --base origin/develop
    else
      echo "pre-push: no origin/develop ref — skipping DCO check (CI enforces it on PRs)"
    fi

    echo "pre-push: python scripts/check-parity-checklist.py --self-test"
    python scripts/check-parity-checklist.py --self-test

    echo "pre-push: python scripts/check-release-notes.py --self-test"
    python scripts/check-release-notes.py --self-test

    echo "pre-push: python scripts/check-theme-contrast.py"
    python scripts/check-theme-contrast.py

    echo "pre-push: python scripts/check-apt-parity.py --self-test"
    python scripts/check-apt-parity.py --self-test

    echo "pre-push: python scripts/check-code-scanning-alerts.py --self-test"
    python scripts/check-code-scanning-alerts.py --self-test
  else
    echo "pre-push: python not found — skipping script self-tests"
  fi

  if command -v bash >/dev/null 2>&1; then
    echo "pre-push: bash scripts/generate-release-notes.sh --self-test"
    bash scripts/generate-release-notes.sh --self-test
  fi
fi

# ── Workflow lint ────────────────────────────────────────────────────────
# The Lints job runs actionlint, which runs shellcheck over every `run:` block.
# That is the check a literal backtick in a single-quoted shell string trips
# (SC2016), and it is not something `cargo fmt` or clippy can see. The hook does
# not download tools, so it lints only when actionlint is installed; without a
# shell linter, actionlint still checks the workflow schema but not the scripts.
if command -v actionlint >/dev/null 2>&1; then
  echo "pre-push: actionlint"
  # The files are passed explicitly: `actionlint` with no arguments can block on
  # stdin in an interactive shell, which would hang the push with no output.
  workflows=()
  while IFS= read -r workflow; do
    workflows+=("$workflow")
  done < <(git ls-files '.github/workflows/*.yml' '.github/workflows/*.yaml')
  if [[ "${#workflows[@]}" -gt 0 ]]; then
    actionlint_flags=(-color)
    case "$(uname -s)" in
      MINGW*|MSYS*|CYGWIN*)
        # actionlint pipes every `run:` block to shellcheck. On Windows that
        # deadlocks once a block outgrows the anonymous-pipe buffer: the ~6 KB
        # block in pat-expiry-guard.yml hangs the push forever. The workflow
        # schema is still linted here, and the run blocks are still shellchecked
        # by the Linux Lints job (which is why this only skips the integration).
        actionlint_flags+=(-shellcheck=)
        ;;
    esac
    actionlint "${actionlint_flags[@]}" "${workflows[@]}"
  fi
else
  echo "pre-push: actionlint not found — skipping workflow lint (CI Lints runs it)"
fi

echo "pre-push: all checks passed"
