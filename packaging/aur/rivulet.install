post_install() {
    echo ">> Updating icon cache..."
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor || true

    echo ">> Updating desktop database..."
    update-desktop-database -q usr/share/applications || true

    echo ""
    echo "Rivulet has been installed to /opt/rivulet/"
    echo "  Launch:  rivulet-gui"
    echo "  CLI:     rivulet --help"
    echo ""
    echo "Required GStreamer plugins for full functionality:"
    echo "  sudo pacman -S gst-plugins-base gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-libav"
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ">> Updating icon cache..."
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor || true

    echo ">> Updating desktop database..."
    update-desktop-database -q usr/share/applications || true
}
